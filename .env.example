# Copy to .env and fill in real values. Never commit .env.

# Neon connection string for the project database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# Stops dbmate from writing db/schema.sql; the migrations are the only schema definition.
DBMATE_NO_DUMP_SCHEMA=true

# OpenAI-compatible LLM gateway (chat + embeddings) and its key.
LLM_GATEWAY_URL=https://GATEWAY_HOST/v1
OPENAI_API_KEY=sk-your-key-here
